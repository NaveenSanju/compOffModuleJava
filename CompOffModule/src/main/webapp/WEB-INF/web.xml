<?xml version="1.0" encoding="utf-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
<filter>
    <filter-name>struts2</filter-name>
    <filter-class>com.struts2.gae.dispatcher.GaeFilterDispatcher</filter-class>
    <init-param>
      <param-name>actionPackages</param-name>
      <param-value>com.action</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>struts2</filter-name>
    <url-pattern>*.action</url-pattern>
  </filter-mapping>
  <listener>
    <listener-class>com.serviceimpl.InitListener</listener-class>
  </listener>
  <listener>
    <listener-class>com.serviceimpl.OgnlListener</listener-class>
  </listener>
  
    <!-- Email settings (environment variables or the git-ignored WEB-INF/mailgun.env), read once at start-up -->
  <listener>
    <listener-class>com.util.MailConfig</listener-class>
  </listener>
  <!-- Approval servlets: each run carries out ONE staged decision (approve or reject, "In Process") of its flow.
       Not scheduled here (App Engine cron). -->
  <servlet>
    <servlet-name>holidayApprovals</servlet-name>
    <servlet-class>com.action.HolidayApprovalServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>holidayApprovals</servlet-name>
    <url-pattern>/processHolidayApprovals</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>compOffApprovals</servlet-name>
    <servlet-class>com.action.CompOffApprovalServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>compOffApprovals</servlet-name>
    <url-pattern>/processCompOffApprovals</url-pattern>
  </servlet-mapping>
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  
  
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
  
 
</web-app>